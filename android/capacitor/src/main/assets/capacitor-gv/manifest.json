{
    "manifest_version": 2,
    "name": "capacitor-gv",
    "version": "1.0",
    "description": "Example messaging web extension.",
    "browser_specific_settings": {
        "gecko": {
            "id": "capacitor-gv@onslip.com",
            "strict_min_version": "91.1.0"
        }
    },
    "background": {
        "scripts": [
          "capacitor-api-handler.mjs",
          "capacitor-proxy-handler.mjs"
        ],
        "persistent": false,
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "capacitor-message-handler.js"
            ],
            "all_frames": true,
            "run_at": "document_start"
        }
    ],
    "permissions": [
        "nativeMessaging",
        "nativeMessagingFromContent",
        "geckoViewAddons",
        "proxy",
        "tabs",
        "webNavigation",
        "webRequest",
        "<all_urls>"
    ]
}